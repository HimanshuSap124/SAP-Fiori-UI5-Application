<mvc:View controllerName="fiori.ui5app.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Panel>
            <VBox id="view1Vbox1">
                <Text id="view1Text1" text="{i18n>view1Text1}" />
            
                <Text id="view1Text2" text="This is view 1, click the below button to Navigate to View2." />

                <Button id="view1Btn1" text="Move to View2" press="moveToView2" />
            
            </VBox>
        </Panel>

        <Panel>
            <Label text="Click on any Employee to Navigate to Employee View using Parameterized Routing." />
            <Table id="idProductsTable" items="{MyModel>/employees}" headerText="Employee Table" mode="SingleSelectMaster" selectionChange="onRowSelect">		
                <columns>
                    <Column>
                        <Text text="ID" />
                    </Column>
                    <Column>
                        <Text text="Name" />
                    </Column>
                    <Column>
                        <Text text="Role" />
                    </Column>
                    <Column>
                        <Text text="City" />
                    </Column>
                    <Column>
                        <Text text="Rating" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{MyModel>id}" />
                            <Text text="{MyModel>name}" />
                            <Text text="{MyModel>role}" />
                            <Text text="{MyModel>city}" />
                            <Text text="{MyModel>rating}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>
        
        
        <Panel>
            <Label text="Click on any Employee to Navigate to Employee View using Query Parameter Routing." />
            <Table id="idProductsTable2" items="{MyModel>/employees}" headerText="Employee Table" mode="SingleSelectMaster" selectionChange="onRowSelect2">		
                <columns>
                    <Column>
                        <Text text="ID" />
                    </Column>
                    <Column>
                        <Text text="Name" />
                    </Column>
                    <Column>
                        <Text text="Role" />
                    </Column>
                    <Column>
                        <Text text="City" />
                    </Column>
                    <Column>
                        <Text text="Rating" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text text="{MyModel>id}" />
                            <Text text="{MyModel>name}" />
                            <Text text="{MyModel>role}" />
                            <Text text="{MyModel>city}" />
                            <Text text="{MyModel>rating}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </Panel>


    </Page>
</mvc:View>